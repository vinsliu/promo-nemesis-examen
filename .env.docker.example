# Configuration locale Docker : copier vers .env.docker (non versionne).
JWT_SECRET=replace-with-a-random-secret
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
WEB_PORT=8080

# Secret partage uniquement par backend, gateway et notifications (distinct du JWT).
INTERNAL_API_TOKEN=replace-with-another-random-secret
# smtp en local, resend sur Render. En mode smtp, destinataire des alertes admin.
EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL=
# Mode test Resend : uniquement l'adresse associee au compte Resend.
RESEND_API_KEY=
NOTIFICATION_TEST_EMAIL=
