{
  "scripts": {
    "start:notifications": "nodemon microservices/notifications/index.js",
    "start:stock-management": "nodemon microservices/stock-management/index.js",
    "start:gateway": "nodemon gateway/server.js",
    "start:backend": "nodemon backend/server.js",
    "start:frontend": "npm --prefix frontend start",
    "start:all": "npm-run-all --parallel start:notifications start:stock-management start:gateway start:backend start:frontend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write backend gateway microservices frontend/src",
    "format:check": "prettier --check backend gateway microservices frontend/src",
    "docs": "jsdoc2md --files 'backend/*.js' 'backend/{controllers,middlewares,services,validation}/*.js' 'gateway/server.js' 'microservices/*/index.js' 'frontend/src/services/session.js' > docs/API.md"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdoc-to-markdown": "^9.1.3",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10"
  }
}
